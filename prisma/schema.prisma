generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Car {
  id Int @id @default(autoincrement())

  title String
  slug  String @unique

  brand String?
  model String?

  price    String
  oldPrice String?

  badge        String?
  country      String?
  city         String?
  availability String?

  year          String?
  engine        String?
  power         String?
  fuel          String?
  mileage       String?
  drive         String?
  gearbox       String?
  body          String?
  color         String?
  grade         String?
  complectation String?
  documents     String?

  auctionUrl String?

  previewImage String?
  image        String?
  mainImage    String?

  shortDescription String?
  description      String?
  features         String?
  conditionText    String?
  documentsText    String?
  serviceText      String?

  seoTitle       String?
  seoDescription String?

  isActive   Boolean @default(true)
  showOnHome Boolean @default(false)
  isFeatured Boolean @default(false)

  sortOrder Int @default(100)

  images CarImage[]
  leads  Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([showOnHome])
  @@index([isFeatured])
  @@index([sortOrder])
  @@index([brand])
  @@index([country])
}

model CarImage {
  id Int @id @default(autoincrement())

  carId Int
  car   Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  image     String
  alt       String?
  sortOrder Int     @default(100)

  createdAt DateTime @default(now())

  @@index([carId])
  @@index([sortOrder])
}

model Lead {
  id Int @id @default(autoincrement())

  leadType String @default("general")
  source   String?

  customerName String?
  phone        String
  messenger    String?
  city         String?
  budget       String?
  message      String?

  carId Int?
  car   Car? @relation(fields: [carId], references: [id], onDelete: SetNull)

  carTitleSnapshot String?
  carSlugSnapshot  String?

  status String @default("new")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([carId])
}

model AdminUser {
  id Int @id @default(autoincrement())

  email        String @unique
  passwordHash String

  name String?

  role String @default("admin")

  isActive Boolean @default(true)

  pushSubscriptions PushSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PushSubscription {
  id Int @id @default(autoincrement())

  adminId Int
  admin   AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  endpoint String @unique
  p256dh   String
  auth     String

  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminId])
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}
